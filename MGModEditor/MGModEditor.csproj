<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>MG-512x512.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <Version>1.3.1.1</Version>
  </PropertyGroup>

  <PropertyGroup>
      <ImplicitUsings>enable</ImplicitUsings>
      <PublishSingleFile>true</PublishSingleFile>
      <SelfContained>false</SelfContained>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
      <!-- 构建（多文件，IDE 调试用）输出到项目 bin\；单文件发布输出见下方 AfterBuild 目标。
           路径统一见仓库根 Directory.Build.props。 -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MG-512x512.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0 " />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\MG-512x512.png" />
    <None Remove="Assets\MG_Studio-512x512-Black.png" />
    <None Remove="Assets\MG_Studio-512x512-White.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MG-512x512.png" />
    <Resource Include="Assets\MG_Studio-512x512-Black.png" />
    <Resource Include="Assets\MG_Studio-512x512-White.png" />
    <Resource Include="Assets\thanks\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="res\config\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="res\config\defaultConfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="res\config\EditorSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="res\i18n\*.json">
      <LogicalName>MGEditor.i18n.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 一键构建：Build 完成后自动 publish 单文件到 Build\SPT_Runtime\user\mods\MGMod\
       （app.txt 单文件编译方案。IDE 原版 Build 按钮即可产出单文件，无需手动 publish。
         防递归：仅在非 publish 场景触发一次。） -->
  <Target Name="PublishSingleFileAfterBuild" AfterTargets="Build"
          Condition="'$(PublishSingleFileAfterBuildDone)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishSingleFile=true;PublishSingleFileAfterBuildDone=true;PublishDir=$(MGModModsOutputDir)MGMod\" />
  </Target>

</Project>
