<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"           
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:MGEditor.Controls"
    xmlns:helpers="clr-namespace:MGEditor.Helpers"
    xmlns:services="clr-namespace:MGEditor.Services">

    <helpers:KeyValueDisplayConverter x:Key="KeyValueDisplayConverter" />

    <Style TargetType="{x:Type controls:ComboxFrame}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ComboxFrame}">
                    <Grid>
                        <Border
                            Padding="5"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,1,1,1"
                            CornerRadius="5,5,5,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MinWidth="200" Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button
                                    Grid.Column="0"
                                    Content="{TemplateBinding ButtonContent}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    MinHeight="36"
                                    Margin="20,0,0,0">
                                    <ui:Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding}"
                                                TextWrapping="Wrap"
                                                TextTrimming="CharacterEllipsis"
                                                TextAlignment="Center" />
                                        </DataTemplate>
                                    </ui:Button.ContentTemplate>
                                </ui:Button>
                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType={x:Type controls:ComboxFrame}}}"
                                    SelectedValue="{Binding SelectedValue, RelativeSource={RelativeSource AncestorType={x:Type controls:ComboxFrame}}}"
                                    SelectedValuePath="Key"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    MinWidth="150">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource KeyValueDisplayConverter}">
                                                        <Binding />
                                                        <Binding Path="CurrentLanguage" Source="{x:Static services:TranslationService.Instance}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            
    </Style>
    
</ResourceDictionary>