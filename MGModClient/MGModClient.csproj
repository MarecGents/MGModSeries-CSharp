<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MGModClient</AssemblyName>
    <RootNamespace>MGModClient</RootNamespace>
    <Version>0.1.0</Version>
    <PluginGuid>com.mgmod.client</PluginGuid>
    <PluginName>MGModClient</PluginName>
    <ReleaseOutputDir>$(MGModPluginsOutputDir)MGModClient\</ReleaseOutputDir>
  </PropertyGroup>

  <!-- 客户端版 MGModEditor：只做配置镜像编辑 + 文件写回，不打游戏逻辑补丁。
       因此仅依赖 BepInEx + 0Harmony（ConfigurationManager 走反射调用），
       不引用 Assembly-CSharp / hollowed / spt-* —— 版本脆弱性最低（落地方案报告 §一）。 -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\Reference\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\Reference\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\Reference\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\Reference\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\Reference\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Rig Layouts 注入用：AssetBundle API + ContainedGridsView/ResourcesCache（Assembly-CSharp） -->
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\Reference\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\Reference\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ContainedGridsView 基类链依赖 Odin 序列化 -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>..\Reference\Managed\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization.Config">
      <HintPath>..\Reference\Managed\Sirenix.Serialization.Config.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Generate constants from MSBuild properties so [BepInPlugin] stays in sync -->
  <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginInfoFile>$(IntermediateOutputPath)MGModClientCompileConstants.g.cs</PluginInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <PluginInfoLines Include="// &lt;auto-generated /&gt; Generated by the GeneratePluginInfo build target." />
      <PluginInfoLines Include="namespace MGModClient" />
      <PluginInfoLines Include="{" />
      <PluginInfoLines Include="    internal static class PluginInfo" />
      <PluginInfoLines Include="    {" />
      <PluginInfoLines Include="        public const string GUID = &quot;$(PluginGuid)&quot;%3B" />
      <PluginInfoLines Include="        public const string NAME = &quot;$(PluginName)&quot;%3B" />
      <PluginInfoLines Include="        public const string VERSION = &quot;$(Version)&quot;%3B" />
      <PluginInfoLines Include="    }" />
      <PluginInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(PluginInfoFile)" Lines="@(PluginInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(PluginInfoFile)" />
      <FileWrites Include="$(PluginInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Build output: copy dll to Build/BepInEx/plugins/MGModClient/ -->
  <Target Name="CopyBuildOutput" AfterTargets="Build">
    <MakeDir Directories="$(ReleaseOutputDir)" />
    <ItemGroup>
      <RemainingFiles Include="$(OutputPath)**/*" Exclude="$(OutputPath)*.pdb;$(OutputPath)*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(RemainingFiles)"
          DestinationFiles="@(RemainingFiles->'$(ReleaseOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
